<|start_of_role|>system<|end_of_role|>You are a helpful assistant with access to tools.<|end_of_text|>
<|start_of_role|>available_tools<|end_of_role|>[
    {
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "Get the current weather for a city",
            "parameters": {
                "properties": {
                    "location": {
                        "description": "City name",
                        "type": "string"
                    }
                },
                "required": [
                    "location"
                ],
                "type": "object"
            }
        }
    }
]<|end_of_text|>
<|start_of_role|>user<|end_of_role|>What is the weather in Paris?<|end_of_text|>
<|start_of_role|>assistant<|end_of_role|><|end_of_text|>
<|start_of_role|>tool<|end_of_role|>{"temperature": 21}<|end_of_text|>
<|start_of_role|>assistant<|end_of_role|>It is 21 degrees in Paris.<|end_of_text|>
<|start_of_role|>user<|end_of_role|>Thanks!<|end_of_text|>
<|start_of_role|>assistant<|end_of_role|>